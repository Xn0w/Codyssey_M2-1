# .env 예시. 이 파일을 .env 로 복사한 뒤 값을 채운다. (.env 는 커밋하지 않는다)
OPENAI_API_KEY=
DATA_GO_KR_SERVICE_KEY=

# 총괄 모의 센서 (기본 켜짐 — 끄려면 0)
# ORCH_UGV_THERMAL: UGV 에 모의 열화상을 붙인다 (드론·UGV 를 함께 허용한 열화상 임무에서 가까운 UGV 가 뽑힐 수 있다)
# ORCH_AUTO_RECON_GROUND: 신고 접수 때 자동 초기 정찰 후보에 UGV 도 넣는다 (ORCH_UGV_THERMAL 도 켜져 있어야 뽑힌다)
ORCH_UGV_THERMAL=1
ORCH_AUTO_RECON_GROUND=1

# UGV 도로 AI (봉인 기능 — 서버를 UGV_AGENT=1 로 띄울 때만 쓴다. 없어도 기본 실행·트윈은 그대로 돈다)
# Gemini 키 (판단 + 임베딩). 총괄 키와 같은 키를 써도 된다
UGV_AGENT_API_KEY=
# 판단 모델 (기본 gemini-3.5-flash-lite — 빠르다. 3.8-flash 도 되지만 응답이 수십 초까지 늘어진다). 서버에는 .env 가 아니라 셸 환경변수로 준다 — .env 의 값은 점검 도구(probe·rag_index·rag_eval)만 읽는다
# UGV_AGENT_MODEL=gemini-3.5-flash-lite
