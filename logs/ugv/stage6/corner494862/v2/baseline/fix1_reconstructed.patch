+def _arc_span(sp, R=8.2, turn_deg=90.0):
+    """_arc_route 원호 구간 [접점, 끝점] 의 진행 거리 (출발 lead m 뒤부터 원호 길이만큼)."""
+    s0 = sp.cum[min(range(len(sp.pts)), key=lambda k: math.dist(sp.pts[k], (0.0, 0.0)))]
+    return s0, s0 + math.radians(turn_deg) * R
+
